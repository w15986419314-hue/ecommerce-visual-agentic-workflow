{
  "version": "1.1",
  "description": "EVAW Knowledge catalog — filesystem source of truth for SKU readiness",
  "root_layout": {
    "platforms": "Shared platform safe-zone / canvas / text rules",
    "brands/<brand_id>/vis.json": "Brand VIS tokens",
    "skus/<sku_id>/manifest.json": "Per-SKU readiness + refs",
    "skus/<sku_id>/structure.json": "Product structure constraints",
    "skus/<sku_id>/structure_ref.png": "Optional real structure photo for I2I"
  },
  "prefix_defaults": [
    {
      "prefix": "SKU-BED-",
      "match_case_insensitive": true,
      "except_sku_ids": [
        "SKU-BED-MISSING"
      ],
      "clone_from": "SKU-BED-001",
      "notes": "Demo convenience: unknown SKU-BED-* (except MISSING) inherit ready bundle from SKU-BED-001 so form sync does not need exemption. Production should add an explicit sku folder."
    },
    {
      "prefix": "sku-bed-",
      "match_case_insensitive": true,
      "except_sku_ids": [
        "sku-bed-missing",
        "SKU-BED-MISSING"
      ],
      "clone_from": "sku-bed-01",
      "notes": "Lowercase form variants (e.g. sku-bed-02) inherit sku-bed-01 ready pack in demo."
    }
  ],
  "formal_ready_skus": [
    "folding-bed-01",
    "SKU-BED-STRUCT",
    "sku-bed-01"
  ],
  "known_trial_skus": [
    "sku-bed-01",
    "SKU-BED-001",
    "SKU-BED-STRUCT",
    "SKU-BED-FORM-001",
    "SKU-BED-DEMO",
    "SKU-BED-NEW",
    "SKU-BED-BITABLE-001",
    "folding-bed-01"
  ],
  "explicit_skus": {
    "folding-bed-01": {
      "status": "ready",
      "path": "skus/folding-bed-01",
      "role": "live-happy default · real product I2I"
    },
    "SKU-BED-STRUCT": {
      "status": "ready",
      "path": "skus/SKU-BED-STRUCT",
      "role": "structure-sensitive HITL / I2I lock demo"
    },
    "sku-bed-01": {
      "status": "ready",
      "path": "skus/sku-bed-01",
      "role": "YSRJ form-intake hospitality pack"
    }
  },
  "skus": {
    "folding-bed-01": {
      "status": "ready",
      "path": "skus/folding-bed-01"
    },
    "SKU-BED-STRUCT": {
      "status": "ready",
      "path": "skus/SKU-BED-STRUCT"
    },
    "sku-bed-01": {
      "status": "ready",
      "path": "skus/sku-bed-01"
    }
  }
}
