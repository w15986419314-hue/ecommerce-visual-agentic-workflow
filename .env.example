# Copy to .env.local and fill in. Never commit .env.local.

# --- Domestic Live Gen (通义万相 / DashScope) — preferred ---
# Get key: https://bailian.console.aliyun.com/ (API-KEY)
# export DASHSCOPE_API_KEY=sk-xxxx
# export EVAW_GEN_MODE=live
# export EVAW_GEN_PROVIDER=auto
# export EVAW_DASHSCOPE_MODEL=wan2.2-t2i-plus
# export EVAW_DASHSCOPE_SIZE=1024*1024
# export EVAW_DASHSCOPE_PROMPT_EXTEND=false
# export EVAW_DASHSCOPE_I2I=1
# export EVAW_DASHSCOPE_I2I_MODEL=wanx-v1
# export EVAW_DASHSCOPE_REF_STRENGTH=0.85
# export EVAW_DASHSCOPE_REF_MODE=repaint

# --- Optional alternate: 豆包 Seedream / 火山方舟 Ark ---
# Get key: https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# export ARK_API_KEY=xxxx
# (alias also accepted: DOUBAO_API_KEY)
# export EVAW_DOUBAO_MODEL=doubao-seedream-4-0-250828
# export EVAW_DOUBAO_SIZE=2K
# export EVAW_DOUBAO_WATERMARK=false

# --- OpenAI (often blocked in CN with 403 unsupported_country_region) ---
# export OPENAI_API_KEY=sk-xxxx
# export OPENAI_ORG_ID=
# export EVAW_OPENAI_IMAGES_URL=https://api.openai.com/v1/images/generations

# --- Feishu ---
# export FEISHU_APP_ID=
# export FEISHU_APP_SECRET=
# export FEISHU_CHAT_ID=
